{
  "Serilog": {
    "MinimumLevel" : {
      "Default" : "Information",
      "Override" : {
        "Microsoft": "Information",
        "System": "Warning"
      }
    }
  },
  "ElasticConfigurations": {
    "Uri": "http://elasticsearch:9200"
  },
  "Stripe" : {
    "PublishableKey": "STRIPE_PUBLIC_KEY",
    "SecretKey": "STRIPE_SECRET_KEY",
    "WebhookSecret": "WEBHOOK_SECRET"
  },
  "RabbitMq": {
    "HostUri": "rabbitmq://localhost:2100",
    "UserName": "guest",
    "Password": "guest"
  },
  "AllowedHosts": "*"
}
