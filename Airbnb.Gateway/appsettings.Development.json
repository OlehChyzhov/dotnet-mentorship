{
  "Serilog": {
    "MinimumLevel" : {
      "Default" : "Information",
      "Override" : {
        "Microsoft": "Information",
        "System": "Warning"
      }
    }
  },
  "ElasticConfigurations": {
    "Uri": "http://localhost:9200"
  },
  "ReverseProxy" : {
    "Routes" : {
      "monolith-route": {
        "ClusterId": "monolith-cluster",
        "RateLimiterPolicy" : "SlidingWindows",
        "Match": {
          "Path": "api/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      },
      "audit-route": {
        "ClusterId": "audit-cluster",
        "RateLimiterPolicy" : "SlidingWindows",
        "Match" : {
          "Path": "api/audit/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "RateLimiterPolicy" : "SlidingWindows",
        "Match" : {
          "Path": "api/payment/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "monolith-cluster": {
        "Destinations": {
          "airbnb-api-first": {
            "Address": "http://localhost:3101"
          },
          "airbnb-api-second": {
            "Address": "http://localhost:3102"
          },
          "airbnb-api-third": {
            "Address": "http://localhost:3103"
          }
        }
      },
      "audit-cluster" : {
        "Destinations": {
          "airbnb-audit-api-first": {
            "Address" : "http://localhost:3201"
          },
          "airbnb-audit-api-second": {
            "Address" : "http://localhost:3202"
          },
          "airbnb-audit-api-third": {
            "Address" : "http://localhost:3203"
          }
        }
      },
      "payment-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "airbnb-payment-api-first": {
            "Address": "http://localhost:3301"
          }
        }
      }
    }
  }
}
