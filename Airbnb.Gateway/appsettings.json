{
  "Serilog": {
    "MinimumLevel" : {
      "Default" : "Information",
      "Override" : {
        "Microsoft": "Information",
        "System": "Warning"
      }
    }
  },
  "ElasticConfigurations": {
    "Uri": "http://elasticsearch:9200"
  },
  "ReverseProxy" : {
    "Routes" : {
      "monolith-route": {
        "ClusterId": "monolith-cluster",
        "RateLimiterPolicy" : "SlidingWindows",
        "Match": {
          "Path": "api/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      },
      "audit-route": {
        "ClusterId": "audit-cluster",
        "RateLimiterPolicy" : "SlidingWindows",
        "Match" : {
          "Path": "api/audit/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "monolith-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "airbnb-api-first": {
            "Address": "http://airbnb.api.first:8080"
          },
          "airbnb-api-second": {
            "Address": "http://airbnb.api.second:8080"
          },
          "airbnb-api-third": {
            "Address": "http://airbnb.api.third:8080"
          }
        }
      },
      "audit-cluster" : {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "airbnb-audit-api-first": {
            "Address" : "http://airbnb.audit.api.first:8080"
          },
          "airbnb-audit-api-second": {
            "Address" : "http://airbnb.audit.api.second:8080"
          },
          "airbnb-audit-api-third": {
            "Address" : "http://airbnb.audit.api.third:8080"
          }
        }
      }
    }
  }
}
